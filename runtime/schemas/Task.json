{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },
    "context": { "type": "string" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "failed"] }
  },
  "required": ["id", "description", "status"]
}
