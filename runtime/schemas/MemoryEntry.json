{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryEntry",
  "type": "object",
  "properties": {
    "entryId": { "type": "string" },
    "agentId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "enum": ["observation", "reflection", "action", "plan"] },
    "content": { "type": "object" }
  },
  "required": ["entryId", "agentId", "timestamp", "type", "content"]
}
