{
  "mcpServers": {
    "vault-memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.3.0", "REPLACE_WITH_VAULT_PATH"],
      "comment": "Example only. Point at YOUR private workspace. Never commit the live config."
    },
    "stitch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: REPLACE_WITH_YOUR_STITCH_KEY"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.85"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.6.0"]
    },
    "magicuidesign-mcp": {
      "command": "npx",
      "args": ["-y", "@magicuidesign/mcp@2.1.0"],
      "comment": "Free Magic UI MCP. Optional. Never always-on. Do not claim Pro."
    }
  }
}
