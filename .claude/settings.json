{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs session" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs shell" }]
      },
      {
        "matcher": "PowerShell",
        "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs shell" }]
      },
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs read" }]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs edit" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs edit" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs stop" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs subagent-start" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node kit/hooks/guard.mjs subagent-stop" }] }
    ]
  }
}
