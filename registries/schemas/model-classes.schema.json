{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestraModelClasses",
  "type": "object",
  "additionalProperties": false,
  "required": ["classes", "limitless"],
  "properties": {
    "note": { "type": "string" },
    "limitless": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optional", "repository"],
      "properties": {
        "optional": { "type": "boolean" },
        "repository": { "type": "string" }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "use"],
        "properties": {
          "id": { "type": "string" },
          "use": { "type": "string" }
        }
      }
    }
  }
}
