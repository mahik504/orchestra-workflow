{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestraSkills",
  "type": "object",
  "additionalProperties": false,
  "required": ["skills"],
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "tier", "source", "license", "hosts", "description_chars", "context_chars", "invocation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "rename_to": { "type": "string" },
          "owner": { "type": "string", "enum": ["orchestra", "upstream"] },
          "tier": { "type": "string" },
          "source": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "license_file": { "type": "string" },
          "hosts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "description_chars": { "type": "integer", "minimum": 0 },
          "triggers": { "type": "string" },
          "context_chars": { "type": "integer", "minimum": 1 },
          "invocation": { "type": "string", "enum": ["user", "model"] }
        }
      }
    }
  }
}
