{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnownSkillHashes",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_from", "hashes"],
  "properties": {
    "note": { "type": "string" },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
