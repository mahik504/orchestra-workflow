#!/bin/sh
# Repo-local hygiene. A failed check blocks the commit.
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "node is required for the hygiene pre-commit hook" >&2
  exit 1
fi
node "$root/runtime/tools/hygiene.js" || exit 1
node "$root/runtime/tools/check-versions.js" || exit 1
node "$root/runtime/tools/check-mermaid.mjs" || exit 1
